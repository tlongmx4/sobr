// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SobrietyStatus {
  SOBER
  IM_NOT
  CUTTING_BACK
  THINKING_ABOUT_IT
  SUPPORTING_SOMEONE
  EXPLORING
  PREFER_NOT_TO_SAY
}

enum FrameworkPreference {
  BIBLE
  TWELVE_STEP
  BOTH
  NEITHER
}

enum ChatRole {
  USER
  ASSISTANT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id String @id @default(cuid())
  email String @unique
  emailVerified DateTime?
  passwordHash String
  name String
  preferredName String?
  username String @unique
  hobbies String[]
  substances String[]
  sobrietyStatus SobrietyStatus @default(EXPLORING)
  sobrietyDate DateTime?
  frameworkPreference FrameworkPreference @default(NEITHER)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checkIns CheckIn[]
  chatMessages ChatMessage[]
  tokens Token[]
}

model Token {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  type TokenType
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model CheckIn {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodRating Int // 1-5
  energyRating Int // 1-5
  cravingRating Int? // 1-5, optional
  journalEntry String? // free text, optional
  createdAt DateTime @default(now())
}

model ChatMessage {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ChatRole
  content String
  createdAt DateTime @default(now())
}

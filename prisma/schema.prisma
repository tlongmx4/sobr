// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SobrietyStatus {
  SOBER
  IM_NOT
  CUTTING_BACK
  THINKING_ABOUT_IT
  SUPPORTING_SOMEONE
  EXPLORING
  PREFER_NOT_TO_SAY
}

enum FrameworkPreference {
  BIBLE
  TWELVE_STEP
  BOTH
  NEITHER
}

enum ChatRole {
  USER
  ASSISTANT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CrisisCategory {
  SUICIDAL_IDEATION
  SELF_HARM
  HARM_TO_OTHERS
  SEVERE_DISTRESS
  OTHER
}

model User {
  id String @id @default(cuid())
  email String @unique
  emailVerified DateTime?
  passwordHash String
  name String
  preferredName String?
  username String @unique
  hobbies String[]
  substances String[]
  sobrietyStatus SobrietyStatus @default(EXPLORING)
  sobrietyDate DateTime?
  showMilestones Boolean @default(false)
  frameworkPreference FrameworkPreference @default(NEITHER)
  onboardingCompletedAt DateTime?
  disclaimersAcceptedAt DateTime?
  disclaimersVersion Int @default(0)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checkIns CheckIn[]
  chatMessages ChatMessage[]
  tokens Token[]
  crisisFlags CrisisFlag[]
  earnedCoins EarnedCoin[]
}

// Sobriety milestone coins. Opt-in display (User.showMilestones), but rows are
// recorded for any user with a sobrietyDate. A milestone can be earned more than
// once across separate sobriety runs, so (userId, milestone) is deliberately NOT
// unique. earnedAt is the moment the threshold was crossed (sobrietyDate +
// thresholdMs); "this run" is everything with earnedAt >= the current
// sobrietyDate. Resets never delete past coins. Cascade-deletes with the user.
model EarnedCoin {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone String // milestone id, references MILESTONES[].id in src/lib/milestones.ts
  earnedAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Token {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  type TokenType
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model CheckIn {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodRating Int // 1-5
  energyRating Int // 1-5
  cravingRating Int? // 1-5, optional
  journalEntry String? // free text, optional
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatMessage {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ChatRole
  content String
  createdAt DateTime @default(now())
  crisisFlags CrisisFlag[]

  @@index([userId, createdAt])
}

// Public beta-interest capture. Standalone, not linked to a User: these are
// prospects before they have an account. No sensitive recovery data here.
model Waitlist {
  id String @id @default(cuid())
  email String @unique
  firstName String?
  note String?
  createdAt DateTime @default(now())
}

// Invite codes gate new signups during the manual-access phase. Created by hand
// (Prisma Studio or a seed) to grant testers access; checked server-side in the
// signup route so the gate cannot be bypassed by calling the API directly.
// `maxUses` = 1 is a single-use code; raise it for a shared cohort code. A code
// is spent when `uses` reaches `maxUses`.
model InviteCode {
  id String @id @default(cuid())
  code String @unique
  label String?
  maxUses Int @default(1)
  uses Int @default(0)
  createdAt DateTime @default(now())
}

// Generic fixed-window rate-limit counter, shared by every throttled endpoint
// (waitlist, auth email/token flows, chat). `key` is an opaque, caller-built
// identifier (e.g. "waitlist:<ipHash>" or "chat:<userId>") — never a raw IP or
// other PII. Rows are disposable: a stale window is overwritten on the next hit.
model RateLimit {
  key String @id
  count Int @default(0)
  windowStart DateTime @default(now())
}

model CrisisFlag {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  severity Severity
  category CrisisCategory
  classifierConfidence Float?
  classifierModel String
  reviewed Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
